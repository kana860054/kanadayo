-- =====================================================================
-- 凍結ユーティリティ (Freecam 中のキャラ強制停止)
-- =====================================================================
local function ApplyFreezeTo(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        savedAutoRotate = hum.AutoRotate
        savedWalkSpeed = hum.WalkSpeed
        pcall(function() savedJumpPower = hum.JumpPower end)
        pcall(function() savedJumpHeight = hum.JumpHeight end)
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        pcall(function() hum.JumpPower = 0 end)
        pcall(function() hum.JumpHeight = 0 end)
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        lockedRootPos = hrp.Position
        lockedRootOrient = hrp.CFrame - hrp.Position
    end
end

local function ReleaseFreezeFrom(char)
    if not char then
        lockedRootPos = nil
        lockedRootOrient = CFrame.new()
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = savedAutoRotate
        hum.WalkSpeed = speedEnabled and currentSpeed or savedWalkSpeed
        pcall(function() hum.JumpPower = savedJumpPower end)
        pcall(function() hum.JumpHeight = savedJumpHeight end)
    end
    lockedRootPos = nil
    lockedRootOrient = CFrame.new()
end

