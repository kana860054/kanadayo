-- スマホ用クリックTP
-- 画面中央を狙って、画面下の大きなTPボタンを押す方式。
-- 小さい場所を直接タップする必要がないので、スマホで操作しやすい。
do
    local isTouchDevice = UserInputService.TouchEnabled

    mobileTpButton = Instance.new("TextButton")
    mobileTpButton.Name = "MobileClickTPButton"
    mobileTpButton.Size = UDim2.new(0, 150, 0, 58)
    mobileTpButton.Position = UDim2.new(0.5, -75, 1, -105)
    mobileTpButton.AnchorPoint = Vector2.new(0, 0)
    mobileTpButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    mobileTpButton.BackgroundTransparency = 0.15
    mobileTpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    mobileTpButton.Text = "TP"
    mobileTpButton.TextSize = 24
    mobileTpButton.Font = Enum.Font.GothamBold
    mobileTpButton.Visible = false
    mobileTpButton.Active = true
    mobileTpButton.AutoButtonColor = true
    mobileTpButton.ZIndex = 50
    mobileTpButton.Parent = screenGui

    mobileTpButtonCorner = Instance.new("UICorner")
    mobileTpButtonCorner.CornerRadius = UDim.new(0, 14)
    mobileTpButtonCorner.Parent = mobileTpButton

    local function MobileTeleportToCenter()
        if not mobileClickTpEnabled then return end

        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        local viewport = cam.ViewportSize
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local ray = cam:ViewportPointToRay(center.X, center.Y)

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}

        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
        if result then
            char:MoveTo(result.Position)
        end
    end

    mobileTpButton.Activated:Connect(MobileTeleportToCenter)

    -- タッチ端末以外ではスマホ用ボタンを出さない。
    -- トグルをONにしたときだけ表示する。
    if not isTouchDevice then
        mobileTpButton.Visible = false
    end
end
