local bv, bg
RunService.RenderStepped:Connect(function()
    -- Fly (Freecam 中は OFF)
    if not freecamEnabled then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            if flyEnabled then
                if not bv then
                    bv = Instance.new("BodyVelocity", hrp)
                    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bg = Instance.new("BodyGyro", hrp)
                    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                end
                local cam = workspace.CurrentCamera
                local dir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
                bv.Velocity = dir * flySpeed
                bg.CFrame = cam.CFrame
            else
                if bv then bv:Destroy() bv = nil end
                if bg then bg:Destroy() bg = nil end
            end
        end
    else
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
    end
end)

-- フリーカメラ視点 + 移動
RunService.RenderStepped:Connect(function()
    if not freecamEnabled then return end
    if not freeCamPos then freeCamPos = camera.CFrame.Position end

    local move = Vector3.new()
    local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
    local fwd = rot.LookVector
    local rgt = rot.RightVector
    local upv = Vector3.new(0, 1, 0)

    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + upv end
    end

    local BASE = 0.5
    freeCamPos = freeCamPos + move * BASE * freecamSpeedMultiplier
    camera.CFrame = CFrame.new(freeCamPos) * CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
end)

-- 戦闘タブ: Follow + Tracer (Freecam 中は停止)
RunService.RenderStepped:Connect(function(dt)
    if freecamEnabled then
        if combatTracerLine then combatTracerLine.Visible = false end
        return
    end

    if not CharacterRef or not HumanoidRef or not RootPartRef then return end

    if CombatSettings.FollowActive then
        RootPartRef.AssemblyLinearVelocity = Vector3.zero
    end

    if CombatSettings.FollowActive and SelectedTarget and SelectedTarget.Character then
        local targetHRP = GetHRP(SelectedTarget.Character)
        if targetHRP then
            if CombatSettings.FollowMode == "normal" then
                RootPartRef.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 7)
            elseif CombatSettings.FollowMode == "v2" then
                local delta = targetHRP.Position - RootPartRef.Position
                local distV = delta.Magnitude
                local speedV = 300
                if distV > 200 then
                    RootPartRef.CFrame = RootPartRef.CFrame:Lerp(
                        CFrame.new(RootPartRef.Position + delta.Unit * speedV * dt), 1
                    )
                else
                    RootPartRef.CFrame = RootPartRef.CFrame:Lerp(
                        targetHRP.CFrame * CFrame.new(0, 0, 7), 0.2
                    )
                end
            elseif CombatSettings.FollowMode == "under" then
                if not combatNoclipConn then EnableCombatNoclip() end
                HumanoidRef.PlatformStand = true
                local goal = targetHRP.CFrame * CFrame.new(0, -12, 0) * CFrame.Angles(math.rad(90), 0, 0)
                RootPartRef.CFrame = RootPartRef.CFrame:Lerp(goal, 0.3)
            end
        end
    else
        if HumanoidRef then HumanoidRef.PlatformStand = false end
        if combatNoclipConn then DisableCombatNoclip() end
    end

    -- Combat Tracer
    if CombatSettings.TracerEnabled
        and SelectedTarget
        and SelectedTarget.Character
        and tracerAvailable
        and combatTracerLine then
        local targetHRP = GetHRP(SelectedTarget.Character)
        if targetHRP and RootPartRef then
            local p1, on1 = camera:WorldToViewportPoint(RootPartRef.Position)
            local p2, on2 = camera:WorldToViewportPoint(targetHRP.Position)
            combatTracerLine.Visible = on1 and on2
            if on1 and on2 then
                combatTracerLine.From = Vector2.new(p1.X, p1.Y)
                combatTracerLine.To = Vector2.new(p2.X, p2.Y)
            end
        else
            combatTracerLine.Visible = false
        end
    else
        if combatTracerLine then combatTracerLine.Visible = false end
    end
end)

